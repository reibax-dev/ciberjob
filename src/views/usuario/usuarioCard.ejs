<article class="user-card">
    <h3><%= usuario.nombre %></h3>
    <p>Email: <%= usuario.email %></p>
    <p>Teléfono: <%= usuario.telefono %></p>
    <p>Admin: <%= usuario.admin ? "Sí" : "No" %></p>
    <% if(currentPath === '/usuario'){ %>
    <a href="/usuario/<%=usuario.idUsuario%>">Visitar</a>
    <% } %>
    <form method="post" action="/usuario/<%=usuario.idUsuario%>/delete">
        <button>Eliminar</button>
    </form>

</article>