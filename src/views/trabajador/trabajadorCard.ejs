<article class="user-card tarjeta tarjeta-trabajador tarjeta--amarillo">
    <h3 class="tarjeta-titulo"><%= usuario.nombre %></h3>
    <p class="tarjeta-dato">Id de trabajador: #<%= trabajador.idTrabajador %></p>
    <p class="tarjeta-dato">Id de usuario: <%= trabajador.idUsuario %></p>
    <p class="tarjeta-dato">Email: <%= usuario.email %></p>
    <p class="tarjeta-dato">Teléfono: <%= usuario.telefono %></p>
    <!-- <p class="tarjeta-dato">Admin: <%= usuario.admin ? "Sí" : "No" %></p> -->
    
    
    <p class="tarjeta-etiqueta">Curriculum Vitae</p>
    <p class="tarjeta-cv"><%= trabajador.cv %></p>
    <div class="tarjeta-acciones">
    <a href="/trabajador/<%=trabajador.idTrabajador%>" class="btn btn-enlace">Visitar</a>
    <a href="/trabajador/<%=trabajador.idTrabajador%>/edit" class="btn btn-enlace">Editar</a>
    <form method="post" action="/trabajador/<%=trabajador.idTrabajador%>/delete" class="form-inline">
        <button class="btn btn-peligro">Eliminar</button>
    </form>
    </div>

</article>
