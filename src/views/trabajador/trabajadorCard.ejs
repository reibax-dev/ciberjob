<article class="user-card">
    <h3>Trabajador #<%= trabajador.idTrabajador %></h3>
    <p>Id de usuario: <%= trabajador.idUsuario %></p>
    <p>Curriculum Vitae</p>
    <p><%= trabajador.cv %></p>
    <a href="/trabajador/<%=trabajador.idTrabajador%>">Visitar</a>
    <form method="post" action="/trabajador/<%=trabajador.idTrabajador%>/delete">
        <button>Eliminar</button>
    </form>

</article>
