<%- include('../layout/header'); %>

        <h2>
            <%= empresa.nombre %>
        </h2>

        <p>ID de empresa: <%= empresa.idEmpresa %>
        </p>
        <p>ID de usuario asociado: <%= empresa.idUsuario %>
        </p>
        <p class="tarjeta-dato">Usuario: <%= usuario.nombre %>
            </p>
            <p class="tarjeta-dato">Email: <%= usuario.email %>
            </p>
            <p class="tarjeta-dato">Teléfono: <%= usuario.telefono %>
            </p>
            <div class="tarjeta-acciones">
                <% if(currentPath==='/usuario' ){ %>
                    <a href="/usuario/<%=usuario.idUsuario%>" class="btn btn-enlace">Visitar</a>
                <% } %>
                <% if (usuarioSesion.admin || (usuarioSesion.rol === 'Empresa' && usuarioSesion.idTipo === empresa.idEmpresa)) { %>
                <a href="/empresa/<%= empresa.idEmpresa %>/edit">
                    Editar empresa
                </a>
                <% } %>

                <% if (usuarioSesion.admin) { %>
                <form action="/empresa/<%= empresa.idEmpresa %>/delete" method="post"
                    onsubmit="return confirm('¿Seguro que quieres eliminar esta empresa? Se borrarán también su usuario y sus ofertas.');">
                    <button type="submit">Eliminar empresa</button>
                </form>

                <a href="/empresa">Volver al listado</a>
                <% } %>
            </div>

    <%- include('../layout/footer'); %>