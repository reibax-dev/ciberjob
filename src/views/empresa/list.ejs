<%- include('../layout/header'); %>

        <h2 class="titulo-seccion">Empresas</h2>

        <a href="/empresa/new" class="btn btn-enlace">Registrar empresa</a>

        <% if (empresas.length===0) { %>
            <p class="vacio">No hay empresas registradas.</p>
            <% } else { %>
                <ul class="lista-empresas" id="lista-empresas">
                    <% for (const empresa of empresas) { %>
                        <li>
                            <a href="/empresa/<%= empresa.idEmpresa %>">
                                <%= empresa.nombre %>
                            </a>
                        </li>
                        <% } %>
                </ul>
                <% } %>

    <%- include('../layout/footer'); %>