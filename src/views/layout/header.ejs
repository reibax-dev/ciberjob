<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? title + ' | CiberJob' : 'CiberJob' %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="cyber">
<header class="site-header" id="top">
    <nav class="nav" id="nav-principal">
        <h1 class="logo">CiberJob</h1>
        <ul class="nav-links">
            <li><a href="/" <% if (currentPath === '/') { %>aria-current="page"<% } %>>Inicio</a></li>
            <li><a href="/oferta" <% if (currentPath.startsWith('/oferta')) { %>aria-current="page"<% } %>>Ofertas</a></li>
            <li><a href="/empresa" <% if (currentPath.startsWith('/empresa')) { %>aria-current="page"<% } %>>Empresas</a></li>
            <li><a href="/trabajador" <% if (currentPath.startsWith('/trabajador')) { %>aria-current="page"<% } %>>Trabajadores</a></li>
            <li><a href="/categoria" <% if (currentPath.startsWith('/categoria')) { %>aria-current="page"<% } %>>Categorías</a></li>
            <li><a href="/modalidad" <% if (currentPath.startsWith('/modalidad')) { %>aria-current="page"<% } %>>Modalidades</a></li>
            <% if (locals.usuarioSesion) { %>
                <% if (usuarioSesion.admin) { %>
                    <li><a href="/usuario" <% if (currentPath.startsWith('/usuario')) { %>aria-current="page"<% } %>>Usuarios</a></li>
                <% } %>
                <% if (usuarioSesion.rol === 'Empresa') { %>
                    <li><a href="/oferta/new">Publicar oferta</a></li>
                <% } %>
                <li><a href="/auth/logout">Cerrar sesión (<%= usuarioSesion.nombre %>)</a></li>
            <% } else { %>
                <li><a href="/auth/login" <% if (currentPath === '/auth/login') { %>aria-current="page"<% } %>>Iniciar sesión</a></li>
                <li><a href="/auth/register" <% if (currentPath === '/auth/register') { %>aria-current="page"<% } %>>Registro</a></li>
            <% } %>
        </ul>
    </nav>
</header>
<main class="contenido" id="contenido">

