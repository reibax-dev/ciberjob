<%- include('../layout/header', { title: 'Nuevo usuario' }); -%>

<h2 class="titulo-seccion">Registro</h2>
<%- include('../layout/error') -%>

<form action="/auth/register" method="post" class="form-cyber form-auth" id="form-registro">
    <label for="username">Nombre de usuario</label>
    <input type="text" name="username" id="username"  required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email"  required>


    <label for="password">Contraseña</label>
    <input type="password" name="password" id="password" required>

    <label for="passwordRepeat">Repetir contraseña</label>
    <input type="password" name="passwordRepeat" id="passwordRepeat" required>

    <button class="btn btn-primario">Crear</button>
</form>

<div class="enlaces-pie">
<a href="/auth/login" class="enlace-secundario">Iniciar sesión</a>
<a href="/user" class="enlace-volver">Volver</a>
</div>

<%- include('../layout/footer'); -%>
