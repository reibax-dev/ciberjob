<%- include('../layout/header', { title: 'Registro' }); -%>

<h2 class="titulo-seccion">Registro</h2>
<%- include('../layout/error') -%>

<%# Ya no hay registro genérico: cada tipo de usuario tiene su formulario %>
<p>¿Cómo quieres registrarte?</p>
<section class="grid-tarjetas" id="eleccion-registro">
    <article class="tarjeta tarjeta--amarillo">
        <h3 class="tarjeta-titulo">Trabajador</h3>
        <p class="tarjeta-dato">Busca ofertas del futuro e inscríbete en ellas.</p>
        <div class="tarjeta-acciones">
        <a href="/trabajador/new" class="btn btn-primario">Registrarme como trabajador</a>
        </div>
    </article>
    <article class="tarjeta tarjeta--cian">
        <h3 class="tarjeta-titulo">Empresa</h3>
        <p class="tarjeta-dato">Publica tus ofertas y mira quién se inscribe.</p>
        <div class="tarjeta-acciones">
        <a href="/empresa/new" class="btn btn-primario">Registrarme como empresa</a>
        </div>
    </article>
</section>

<div class="enlaces-pie">
<a href="/auth/login" class="enlace-secundario">Iniciar sesión</a>
<a href="/" class="enlace-volver">Volver</a>
</div>

<%- include('../layout/footer'); -%>
