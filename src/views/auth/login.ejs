<%- include('../layout/header', { title: 'Nuevo usuario' }); -%>

<h2 class="titulo-seccion">Iniciar sesión</h2>
<%- include('../layout/error') -%>

<% if(query ){
    if(query.error){
        %>
        <p class="error alerta alerta-error"><%= query.error %></p>
        <%
    }
    if(query.message){
        %>
        <p class="message alerta alerta-ok"><%= query.message %></p>
        <%
    }
}
%>
<form action="/auth/login" method="post" class="form-cyber form-auth" id="form-login">
    <label for="email">Email</label>
    <input type="email" id="email" name="email"  required>


    <label for="password">Contraseña</label>
    <input type="password" name="password" id="password" required>

    <button class="btn btn-primario">Iniciar sesión</button>
</form>

<div class="enlaces-pie">
<a href="/auth/register" class="enlace-secundario">Registro</a>
<a href="/user" class="enlace-volver">Volver</a>
</div>

<%- include('../layout/footer'); -%>
